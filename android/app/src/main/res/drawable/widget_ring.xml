<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="ring" android:innerRadiusRatio="2.5" android:thicknessRatio="9" android:useLevel="false">
            <solid android:color="@color/widget_track" />
        </shape>
    </item>
    <item>
        <rotate android:fromDegrees="-90" android:toDegrees="-90">
            <shape android:shape="ring" android:innerRadiusRatio="2.5" android:thicknessRatio="9" android:useLevel="true">
                <gradient android:type="sweep" android:startColor="@color/widget_amber" android:centerColor="@color/widget_yellow" android:endColor="@color/widget_yellow" />
            </shape>
        </rotate>
    </item>
</layer-list>
