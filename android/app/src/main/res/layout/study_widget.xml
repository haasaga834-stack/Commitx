<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:background="@drawable/study_widget_background" android:orientation="horizontal">
    <LinearLayout android:layout_width="128dp" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center_horizontal">
        <FrameLayout android:layout_width="106dp" android:layout_height="106dp" android:layout_gravity="center_horizontal">
            <ProgressBar android:id="@+id/widget_ring" style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent" android:layout_height="match_parent"
                android:progressDrawable="@drawable/widget_ring" android:max="1000" android:progress="0" android:indeterminate="false" />
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:orientation="vertical" android:gravity="center">
                <TextView android:id="@+id/widget_hours" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="sans-serif-black" android:textSize="28sp" android:includeFontPadding="false" android:maxLines="1" android:textColor="@color/widget_text" />
                <TextView android:id="@+id/widget_hours_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="HRS" android:letterSpacing="0.15" android:fontFamily="sans-serif-medium" android:textSize="9sp" android:textColor="@color/widget_yellow" />
                <TextView android:id="@+id/widget_hours_goal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="sans-serif" android:textSize="10sp" android:maxLines="1" android:textColor="@color/widget_muted" />
            </LinearLayout>
        </FrameLayout>
        <TextView android:id="@+id/widget_streak" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_horizontal" android:layout_marginTop="6dp" android:background="@drawable/widget_pill_outline" android:fontFamily="sans-serif-medium" android:textSize="10sp" android:maxLines="1" android:textColor="@color/widget_yellow" android:visibility="gone" />
    </LinearLayout>
    <ImageView android:layout_width="1dp" android:layout_height="match_parent" android:layout_marginStart="8dp" android:layout_marginEnd="14dp" android:layout_marginTop="6dp" android:layout_marginBottom="6dp" android:background="@color/widget_divider" />
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="4dp">
            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="COMMITX · TODAY’S TO-DO" android:letterSpacing="0.12" android:fontFamily="sans-serif-medium" android:textSize="9sp" android:maxLines="1" android:ellipsize="end" android:textColor="@color/widget_muted" />
            <TextView android:id="@+id/widget_done" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/widget_pill_amber" android:fontFamily="sans-serif-black" android:textSize="9sp" android:letterSpacing="0.06" android:textColor="@color/widget_on_amber" android:visibility="gone" />
        </LinearLayout>
        <LinearLayout android:id="@+id/widget_row_0" android:layout_width="match_parent" android:layout_height="32dp" android:orientation="horizontal" android:gravity="center_vertical">
            <ImageView android:id="@+id/widget_check_0" android:layout_width="34dp" android:layout_height="match_parent" android:paddingEnd="12dp" android:scaleType="fitCenter" android:src="@drawable/widget_check_off" android:contentDescription="Toggle task" />
            <TextView android:id="@+id/widget_task_0" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:fontFamily="sans-serif-medium" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" android:textColor="@color/widget_text" />
        </LinearLayout>
        <LinearLayout android:id="@+id/widget_row_1" android:layout_width="match_parent" android:layout_height="32dp" android:orientation="horizontal" android:gravity="center_vertical">
            <ImageView android:id="@+id/widget_check_1" android:layout_width="34dp" android:layout_height="match_parent" android:paddingEnd="12dp" android:scaleType="fitCenter" android:src="@drawable/widget_check_off" android:contentDescription="Toggle task" />
            <TextView android:id="@+id/widget_task_1" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:fontFamily="sans-serif-medium" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" android:textColor="@color/widget_text" />
        </LinearLayout>
        <LinearLayout android:id="@+id/widget_row_2" android:layout_width="match_parent" android:layout_height="32dp" android:orientation="horizontal" android:gravity="center_vertical">
            <ImageView android:id="@+id/widget_check_2" android:layout_width="34dp" android:layout_height="match_parent" android:paddingEnd="12dp" android:scaleType="fitCenter" android:src="@drawable/widget_check_off" android:contentDescription="Toggle task" />
            <TextView android:id="@+id/widget_task_2" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:fontFamily="sans-serif-medium" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" android:textColor="@color/widget_text" />
        </LinearLayout>
        <TextView android:id="@+id/widget_more" android:layout_width="match_parent" android:layout_height="26dp" android:gravity="end|center_vertical" android:textAlignment="viewEnd" android:text="See all →" android:fontFamily="sans-serif-medium" android:textSize="12sp" android:textColor="@color/widget_yellow" />
    </LinearLayout>
</LinearLayout>
