<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center_vertical" android:background="@drawable/study_widget_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:gravity="center_vertical" android:layout_marginBottom="10dp">
        <TextView android:id="@+id/widget_weekday" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" android:textColor="@color/widget_muted" />
        <TextView android:id="@+id/widget_date" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="2dp" android:fontFamily="serif" android:textSize="26sp" android:maxLines="1" android:ellipsize="end" android:textColor="@color/widget_text" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent"  android:layout_height="wrap_content" android:orientation="vertical">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="TODAY’S TO-DO" android:textSize="10sp" android:textColor="@color/widget_muted" />
        <LinearLayout android:id="@+id/widget_row_0" android:layout_width="match_parent" android:layout_height="30dp" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/widget_check_0" android:layout_width="28dp" android:layout_height="match_parent" android:gravity="center" android:text="○" android:textSize="21sp" android:textColor="@color/widget_orange" />
            <TextView android:id="@+id/widget_task_0" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" android:textColor="@color/widget_text" />
        </LinearLayout>
        <LinearLayout android:id="@+id/widget_row_1" android:layout_width="match_parent" android:layout_height="30dp" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/widget_check_1" android:layout_width="28dp" android:layout_height="match_parent" android:gravity="center" android:text="○" android:textSize="21sp" android:textColor="@color/widget_orange" />
            <TextView android:id="@+id/widget_task_1" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" android:textColor="@color/widget_text" />
        </LinearLayout>
        <LinearLayout android:id="@+id/widget_row_2" android:layout_width="match_parent" android:layout_height="30dp" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/widget_check_2" android:layout_width="28dp" android:layout_height="match_parent" android:gravity="center" android:text="○" android:textSize="21sp" android:textColor="@color/widget_orange" />
            <TextView android:id="@+id/widget_task_2" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" android:textColor="@color/widget_text" />
        </LinearLayout>
        <TextView android:id="@+id/widget_more" android:layout_width="match_parent" android:layout_height="24dp" android:gravity="center_vertical" android:text="See all" android:textSize="11sp" android:textColor="@color/widget_orange" />
    </LinearLayout>
</LinearLayout>
