<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <!-- Focus Shield: CommitX shows its own reminder screen over a blocked app.
         No app is ever hidden, disabled, or uninstalled. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- Focus Shield needs to read labels/icons of the apps it can protect. -->
    <queries>
        <!-- Launcher apps are visible to the user and can be selected individually
             without requesting broad QUERY_ALL_PACKAGES visibility. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <package android:name="com.instagram.android" />
        <package android:name="com.google.android.youtube" />
        <package android:name="com.facebook.katana" />
        <package android:name="com.whatsapp" />
        <package android:name="com.facebook.orca" />
        <package android:name="com.reddit.frontpage" />
        <package android:name="com.twitter.android" />
        <package android:name="com.snapchat.android" />
        <package android:name="com.android.chrome" />
        <package android:name="com.dts.freefireth" />
        <package android:name="com.dts.freefiremax" />
        <package android:name="com.pubg.imobile" />
        <package android:name="com.tencent.ig" />
        <package android:name="com.activision.callofduty.shooter" />
        <package android:name="com.supercell.clashofclans" />
        <package android:name="com.supercell.clashroyale" />
        <package android:name="com.supercell.brawlstars" />
        <package android:name="com.mojang.minecraftpe" />
        <package android:name="com.roblox.client" />
        <package android:name="com.king.candycrushsaga" />
        <package android:name="com.ea.gp.fifamobile" />
    </queries>


    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="false">
        <activity
            android:name=".MainActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode|density|locale|fontScale"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:screenOrientation="unspecified"
            android:theme="@style/AppTheme.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Sole OAuth callback handler: commitx://login-callback/ -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="commitx" android:host="login-callback" />
            </intent-filter>
        </activity>

        <!-- Focus Shield reminder screen (shown over a blocked app). -->
        <activity
            android:name=".FocusShieldActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleInstance"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/AppTheme" />

        <!-- Watches the foreground app while Focus Shield is on. -->
        <service
            android:name=".VerifiedCountdownService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Displays the remaining time of a user-started Verified study commitment on the lock screen, including recovery-break state; stops at timer expiry or an existing verification outcome." />
        </service>
        <receiver android:name=".VerifiedCountdownReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <service android:name=".StandardCountdownService" android:exported="false" android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Displays live remaining time for a user-started Standard study commitment while the app is backgrounded, including recovery breaks; stops at expiry or cancellation. No session rewards are recorded by this service." />
        </service>
        <receiver android:name=".StandardCountdownReceiver" android:exported="false">
            <intent-filter><action android:name="android.intent.action.BOOT_COMPLETED" /></intent-filter>
        </receiver>
        <receiver android:name=".StudyGoalWidget" android:exported="false" android:label="@string/study_widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.DATE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/study_widget_info" />
        </receiver>

        <service
            android:name=".FocusShieldService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps a user-started focus commitment protected by reminding the user when a self-selected app is opened." />
        </service>



        <receiver
            android:name=".AccountabilityEngine"
            android:exported="false">
            <intent-filter>
                <action android:name="app.commitx.mobile.ACCOUNTABILITY" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".TodoActionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="app.commitx.mobile.TOGGLE_TODO" />
                <action android:name="app.commitx.mobile.REPOST_TODOS" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".PlanReminderReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="app.commitx.mobile.PLAN_REMINDER" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".WellnessSoundReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="app.commitx.mobile.WELLNESS_SOUND" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".MotivationReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="app.commitx.mobile.MOTIVATION" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>


        <receiver
            android:name=".ScreenTimeReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="app.commitx.mobile.CHECK_SCREEN_TIME" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
